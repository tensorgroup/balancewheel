#!/usr/bin/env python3
"""bw — leads and rotation.

  bw                                              in a worktree: lead it here (same as bw lead; lead flags
                                                  work too, e.g. bw --use <lead>); elsewhere: bw status
  bw start [path] [--dry-run] [--no-update] [--no-verify]
                                                  update tools, re-verify, pick the lead, open it in
                                                  a Terminal tab (an Orca pane with canvas: orca)
  bw lead [--use <lead> | --auto] [--no-rating]   start the right lead for this worktree
  bw status                                       leads, quota, caps, pins, cc-switch checks, and Orca checks when Orca is in use
  bw probe [plan...]                              read quota now (OpenRouter key; Orca for mapped plans; agy
                                                  awaits its shape), one line per plan
  bw registry [--print]                           rebuild state_dir/registry.json (tools, plans, models, seats,
                                                  leads, profiles, projects, edges); --print shows it
  bw cockpit [--port N] [--no-open]               serve the read-only cockpit on 127.0.0.1 until Ctrl-C; opens
                                                  it in the browser (--no-open: print the one-time URL)
  bw cap <plan> [--resets-at <epoch>]             record that a plan is capped
  bw inbox [--project] [--all]                    open asks from leads and notices from bw (--project: this
                                                  worktree only; --all: answered ones too)
  bw answer <id> "<text>"                         answer an ask (or close a notice); the lead reads it from
                                                  its inbox file
  bw sandbox verify <runtime> [--lead <lead>]     attack-test a bw-contained runtime, record a pass
  bw setup cc-switch                              pre-write cc-switch's settings (before its first launch)
  bw setup claude-pane [--remove]                 install the live pane plugin for Claude Code from this checkout
                                                  (--remove: take out only what this setup added)
  bw seat <id> [-b] [-r] [-d DIR] [--deep] "prompt"   run one read-only seat (the panel runs seats for you)
  bw seat list [--json]                           seats, verification, caps
  bw seat verify [<id>...] [--all]                attack-test each seat (no ids: every reachable seat),
                                                  record a pass per seat id (--changed: only those without one)
  bw run --seat <name> [--model M] [--label L] [--dir D] -- <command>...
                                                  run a local command as a tracked run (start, beat, end rows),
                                                  passing its exit status through
  bw run start --seat <name> [--model M] [--label L] [--dir D]
                                                  record a run start; prints only the run id
  bw run end <run-id> (--ok | --fail [--reason R])
                                                  record the end of a run that bw run start began
  bw live --json [--dir D] [--since EPOCH] [--limit N]
                                                  what runs now and what ran in this worktree, as JSON
  bw panel <checkpoint> [target] [--deep] [--background]   convene a review panel (leads do this for you)
  bw panel ask <panel-id> <seat> "<claim>" [--dispute ID]   relay one claim to one seat
  bw panel log <panel-id> < verdicts.json         log the panel with your verdicts
  bw panel amend <panel-id> < patch.json          amend a logged panel
  bw panel status [<panel-id>]                    open panels of this worktree
  bw improve                                      what bw has seen of how you work, as changes worth making
  bw improve note "<text>"                        add your own note on what got in the way
  bw improve done <key>                           dealt with: it returns only on new evidence (a note never)
  bw pack export --to <dir> [--dry-run]           regenerate the marked catalog block of esc's model-seats pack.yaml
                                                  from the log (prints esc's changelog bullet)
  bw triage install claude                        add the question-triage hook to Claude Code's settings
  bw triage uninstall claude                      remove it (other entries are left alone)
  bw guard install agy                            add the guard hook entry to agy's hooks file
  bw guard uninstall agy                          remove it (other entries are left alone)
  bw guard verify <runtime> [--lead <lead>]       attack-test the guard on a runtime, record a pass
  bw guard verify <runtime> --interactive [--lead <lead>]
                                                  answer two real approval prompts (No, then Yes) at a terminal
  bw guard review [--profile P] [--recent 20] [--sample 5] [--list]
                                                  audit stops and sampled allows, one evidence key at a time
  bw guard review --remark <decision-id>          mark a marked decision again (correct a wrong mark)
  bw guard eval [--runtime pi] [--json]           replay a synthetic set of calls through the rules and the judge;
                                                  exit 0 pass, 1 fail, 75 incomplete
"""
import argparse
import errno
import json
import os
import secrets
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from cockpit import server as cockpit_server, views as cockpit_views  # noqa: E402
from lead import ccswitch, claude_pane, inbox, probes, quota, registry, runner, sandbox, start, status, verify  # noqa: E402
from lead.guard import AGY_AWAITS, AGY_SPIKE_PASSED, evaluate as guard_eval, install as guard_install, review as guard_review  # noqa: E402
from lead.guard.review import safe  # noqa: E402
from lead import improve, live, run_cli, triage_install  # noqa: E402
from seats import cli as seat_cli  # noqa: E402
from panel import cli as panel_cli  # noqa: E402
from packs import export as pack_export  # noqa: E402
from lead.paths import ConfigError, load_config, state_dir  # noqa: E402  (also puts metrics/ on sys.path)
import store  # noqa: E402
import config as metrics_config  # noqa: E402
import summary as metrics_summary  # noqa: E402
from lead.projects import resolve_project, worktree_key  # noqa: E402
from lead import proc  # noqa: E402
from lead.paths import read_json, write_json_atomic  # noqa: E402

COMMANDS = ("lead", "status", "registry", "probe", "start", "inbox", "answer", "cockpit", "cap", "sandbox", "guard", "triage", "improve",
            "setup", "seat", "panel", "pack", "run", "live")
DECIDED_SEEN = "triage-seen.json"  # when `bw inbox --all` last showed the decided items
START_STALE_S = 86400  # tools not updated by bw start for this long get a one-line nudge


def _toplevel(cwd):
    r = proc.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], 5)
    return r.out.strip() if r.rc == 0 and r.out.strip() else None


def default_argv(argv, cwd):
    """Bare `bw`, or only lead flags, means `bw lead`; bare `bw` outside a git worktree means `bw status`.
    Returns (argv, outside) — outside is True when status was chosen because cwd is not in a worktree."""
    if argv and (argv[0] in COMMANDS or argv[0] in ("-h", "--help")):
        return list(argv), False
    if not argv and _toplevel(cwd) is None:
        return ["status"], True
    return ["lead", *argv], False


def lead_nudges(state, cwd, now, config=None):
    """One-line reminders before a lead starts: open inbox items for this worktree, tools not updated by
    `bw start` in over a day (only once bw start has run at all), and changes worth making. Never raises."""
    lines = []
    if config is not None:
        try:
            n = len(_suggestions(config, state, now))
            if n:
                lines.append(f"bw: {n} change{'s' if n != 1 else ''} worth making — bw improve")
        except Exception:  # noqa: BLE001 — a nudge never stops a lead
            pass
    try:
        top = _toplevel(cwd)
        n = len(inbox.open_items(state, worktree_key(top))) if top else 0
        if n:
            lines.append(f"bw: {n} open item{'s' if n != 1 else ''} for this worktree — bw inbox --project")
        d = inbox.decided_since(state, _decided_seen(state), worktree_key(top)) if top else 0
        if d:
            lines.append(f"bw: {d} question{'s' if d != 1 else ''} decided without you — bw inbox --all")
    except Exception:  # noqa: BLE001 — a nudge never stops a lead
        pass
    try:
        ts = (read_json(os.path.join(state, "start.json"), None) or {}).get("ts")
        if isinstance(ts, (int, float)) and not isinstance(ts, bool) and now - ts > START_STALE_S:
            lines.append(f"bw: tools last updated {int((now - ts) // 86400)} day(s) ago — bw start updates and re-verifies")
    except Exception:  # noqa: BLE001
        pass
    return lines


def _count(s):
    n = int(s)
    if n < 0:
        raise argparse.ArgumentTypeError("must be 0 or more")
    return n


def cmd_lead(a, config, state):
    for line in lead_nudges(state, os.getcwd(), time.time(), config):
        print(line, file=sys.stderr)
    return runner.run(config, state, os.getcwd(), use=a.use, auto=a.auto, rating=not a.no_rating)


def cmd_start(a, config, state):
    return start.start(config, state, a.path, dry_run=a.dry_run, verify=not a.no_verify, update=not a.no_update,
                       bw_path=os.path.realpath(__file__))


def cmd_status(a, config, state):
    print("\n".join(status.render(status.facts(config, state, time.time()))))
    return 0


def cmd_probe(a, config, state):
    unknown = [p for p in a.plans if p not in config["plans"]]
    if unknown:
        sys.exit(f"bw: unknown plan {unknown[0]!r}; plans: {sorted(config['plans'])}")
    now = time.time()
    names = a.plans or sorted(config["plans"])
    res = probes.refresh(config, state, now, plans=names, fetch=probes._fetch)
    every = config["rotation"]["probe_every_min"]
    arbitrated = quota.read_quota(state, config, now)
    for name in names:
        a_q = arbitrated.get(name)
        parts = [quota.summary(a_q)]  # carries the snapshot's note when its reading won
        note = (res["snapshots"].get(name) or {}).get("note")
        if note and note not in parts[0]:
            parts.append(note)
        n = quota.notice(a_q, config["plans"][name], now, every)
        if n:
            parts.append(n)
        print(f"{name}: {' — '.join(parts)}")
    for line in res["notes"]:
        print(f"bw: {line}")
    return 0


def cmd_registry(a, config, state):
    reg = registry.build(config, state, time.time())
    registry.write(state, reg)
    if a.print:
        print(json.dumps(reg, indent=2, sort_keys=True))
    else:
        counts = ", ".join(f"{len(reg[k])} {k}" for k in ("tools", "plans", "models", "seats", "leads", "profiles",
                                                           "projects", "edges"))
        print(f"bw: wrote {registry.path(state)} ({counts})")
    return 0


def _port(s):
    n = int(s)
    if not 1024 <= n <= 65535:
        raise argparse.ArgumentTypeError("must be from 1024 to 65535")
    return n


def cmd_cockpit(a, config, state):
    port = a.port or config["cockpit"]["port"]
    if port not in sandbox.denied_ports(config):  # cookies are not port-isolated: leads must not reach it
        print(f"bw: cockpit: port {port} is not denied to lead sandboxes; set cockpit.port to {port} in the config, "
              f"then re-run `bw sandbox verify` for the bw-contained leads", file=sys.stderr)
        return 1
    views = {f"/api/{name}": fn for name, fn in cockpit_views.build(config, state).items()}
    try:
        srv, token = cockpit_server.make_server(port, views, cockpit_server.load_page())
    except OSError as e:
        why = f"port {port} is in use" if e.errno == errno.EADDRINUSE else f"cannot listen on port {port} ({e.strerror or e})"
        print(f"bw: cockpit: {why}; pass --port or set cockpit.port", file=sys.stderr)
        return 1
    url = f"http://127.0.0.1:{port}/?t={token}"
    if a.no_open or not cockpit_server.open_url(url):
        print(f"bw: cockpit at {url} (one-time link; Ctrl-C stops)", flush=True)
    else:
        print(f"bw: cockpit open at http://127.0.0.1:{port}/ (Ctrl-C stops)", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
    return 0


def cmd_cap(a, config, state):
    if a.plan not in config["plans"]:
        sys.exit(f"bw: unknown plan {a.plan!r}; plans: {sorted(config['plans'])}")
    c = quota.record_cap(state, a.plan, time.time(), resets_at=a.resets_at,
                         expiry_hours=config["rotation"]["cap_expiry_hours"])
    print(f"bw: {a.plan} capped until {time.ctime(c['resets_at'])}")
    return 0


def _age(ts, now):
    if not isinstance(ts, (int, float)) or isinstance(ts, bool):
        return "age unknown"
    m = max(now - ts, 0) / 60
    return f"{m:.0f}m ago" if m < 120 else f"{m / 60:.0f}h ago" if m < 48 * 60 else f"{m / 1440:.0f}d ago"


def cmd_inbox(a, config, state):
    try:
        project = resolve_project(os.getcwd(), config).worktree_key if a.project else None
    except ValueError as e:
        print(f"bw: {e}", file=sys.stderr)
        return 2
    try:
        loaded = inbox.load(state)
    except OSError as e:
        print(f"bw: the inbox could not be read ({type(e).__name__}): {inbox.path(state)}", file=sys.stderr)
        return 1
    for w in loaded["warnings"]:
        print(f"bw: inbox warning: {w}", file=sys.stderr)
    items = [i for i in loaded["items"] if (a.all or i["status"] == "open")
             and (project is None or i.get("project") == project)]
    if not items:
        print("bw: inbox empty")
    now = time.time()
    for i in items:
        kind = "ask" if i["type"] == "ask" else i.get("kind")
        where = i.get("worktree") or i.get("project")
        print(f"[{safe(i.get('id'))}] {safe(kind)} · {_age(i.get('ts'), now)} · from {safe(i.get('from'))} · {safe(where)}")
        print(f"  {safe(i.get('text', ''))}")
        if i["status"] == "answered":
            ans = i.get("answer") or {}
            if ans.get("from") == "triage":
                print("  would have decided" if ans.get("shadow") else
                      f"  decided by bw: reverse with bw answer {safe(i.get('id'))} \"…\"")
            else:
                print(f"  answered: {safe(ans.get('text', ''))}")
        elif (i.get("triage") or {}).get("verdict") == "decide":
            print("  would have decided")
    decided = inbox.decided_since(state, _decided_seen(state), project)
    if decided and not a.all:
        print(f"bw: {decided} question{'s' if decided != 1 else ''} decided without you — bw inbox --all")
    shown = [i["answer"]["ts"] for i in items if inbox.decided(i)]
    if a.all and project is None and shown:  # --project hides other worktrees' decisions, so they stay unseen
        write_json_atomic(os.path.join(state, DECIDED_SEEN), {"ts": max(shown)})
    return 0


def _decided_seen(state):
    ts = (read_json(os.path.join(state, DECIDED_SEEN), None) or {}).get("ts")
    return ts if isinstance(ts, (int, float)) and not isinstance(ts, bool) else 0


def cmd_answer(a, config, state):
    try:
        rec = inbox.answer(state, a.id, a.text)
    except OSError as e:
        print(f"bw: the inbox could not be read ({type(e).__name__}): {inbox.path(state)}; nothing recorded",
              file=sys.stderr)
        return 1
    except KeyError:
        print(f"bw: no inbox item {safe(a.id)}; `bw inbox` lists them", file=sys.stderr)
        return 1
    except ValueError:
        print(f"bw: {safe(a.id)} is already answered", file=sys.stderr)
        return 1
    try:
        store.append(store.log_path(config), {"type": "answer", "id": rec["id"], "ask_id": a.id})
        item = next(i for i in inbox.load(state)["items"] if i.get("id") == a.id)
        if item["type"] != "ask":
            print(f"bw: closed notice {safe(a.id)}")
            return 0
        inbox.write_view(state, item["project"])
    except OSError as e:  # the answer itself is recorded; a retry would only say "already answered"
        print(f"bw: answer to {safe(a.id)} recorded, but the lead's inbox file was not refreshed "
              f"({type(e).__name__}); it will refresh at the next session start")
        return 0
    print(f"bw: answered {safe(a.id)}; the lead sees it in its inbox file; tell it to look")
    if item.get("source") == "session":
        print("bw: the lead never saw this id; tell it which question you mean")
    return 0


def _report(ok, msg):
    print(msg, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def cmd_verify(a, config, state):
    return _report(*verify.sandbox_verify(config, state, a.runtime, a.lead))


def _ts_key(ts):
    """A ts in one comparable form: epoch seconds for a number or a store timestamp, 0 for anything else.
    Logs from other setups may hold either, and a str never compares with an int."""
    if isinstance(ts, (int, float)) and not isinstance(ts, bool):
        return float(ts)
    t = metrics_summary._parse(ts)
    return t.timestamp() if t else 0.0


def _watch_last(w):
    """When a watch last changed: its latest update, else its own ts."""
    return max([_ts_key(u.get("ts")) for u in w.get("updates") or []] + [_ts_key(w.get("ts"))])


def _panel_data(config):
    """The main log plus every extra log (`local.logs`, then `improve.panel_logs`): panels (first copy of an id
    wins, sorted by ts), watches (one per id: the copy changed last wins, so its status is the latest), usage."""
    main = store.log_path(config)
    data = store.load(main)
    seen = {p["id"] for p in data["panels"]}
    for log in metrics_config.extra_logs(config, exclude=main):  # logs a setup keeps somewhere other than metrics_log
        extra = store.load(log)
        for p in extra["panels"]:
            if p["id"] not in seen:
                seen.add(p["id"])
                data["panels"] = data["panels"] + [p]
        data["watches"] = data["watches"] + extra["watches"]
        data["usage"] = data["usage"] + extra["usage"]
    watches = {}
    for w in data["watches"]:
        if w["id"] not in watches or _watch_last(w) >= _watch_last(watches[w["id"]]):
            watches[w["id"]] = w
    data["watches"] = list(watches.values())
    data["panels"] = sorted(data["panels"], key=lambda p: _ts_key(p.get("ts")))
    return data


def _suggestions(config, state, now):
    data = _panel_data(config)
    return improve.suggestions(data, inbox.load(state)["items"], now, notes=inbox.notes(state),
                               done=improve.load_done(state), thresholds=config.get("triage", {}).get("thresholds"),
                               gates=improve.gate_facts(config, state, now))


def cmd_improve(a, config, state):
    now = time.time()
    if a.what == "note":
        text = " ".join(a.rest).strip()
        if not text:
            print("bw: improve note needs text", file=sys.stderr)
            return 2
        rec = inbox.note(state, None, os.getcwd(), "user", None, text, secrets.token_hex(4), now=now)
        print(f"bw: noted [{rec['id']}]")
        return 0
    if a.what == "done":
        if len(a.rest) != 1:
            print("bw: improve done takes one key from `bw improve`", file=sys.stderr)
            return 2
        if a.rest[0] not in [s["key"] for s in _suggestions(config, state, now)]:
            print(f"bw: {safe(a.rest[0])} is not a current suggestion; `bw improve` lists them", file=sys.stderr)
            return 2
        improve.mark_done(state, a.rest[0], now)
        print(f"bw: quieted {safe(a.rest[0])}")
        return 0
    found = _suggestions(config, state, now)
    if not found:
        print("bw: nothing to change yet; the evidence builds as you work")
    for s in found:
        print(f"[{safe(s['key'])}] {safe(s['evidence'])}\n  → {safe(s['action'])}")
    return 0


def cmd_triage(a):
    path = triage_install.settings_path()
    try:
        print((triage_install.install if a.sub == "install" else triage_install.uninstall)(path))
    except ValueError as e:
        print(f"bw: {e}", file=sys.stderr)
        return 1
    return 0


def cmd_guard_verify(a, config, state):
    return _report(*verify.guard_verify(config, state, a.runtime, a.lead, interactive_check=a.interactive))


def cmd_guard(a, config, state):
    if a.sub == "verify":
        return cmd_guard_verify(a, config, state)
    if a.sub == "review" and a.remark:
        return guard_review.remark(state, a.remark)
    if a.sub == "review":
        return guard_review.run(state, profile=a.profile, recent=a.recent, sample=a.sample, list_only=a.list)
    if a.sub == "eval":
        return guard_eval.cli(config, state, a.runtime, as_json=a.json)
    path = guard_install.hooks_path()
    if a.sub == "install":
        if not AGY_SPIKE_PASSED:
            print(f"bw: {AGY_AWAITS}", file=sys.stderr)
            return 1
        try:
            print(guard_install.install_agy(path, state))
        except ValueError as e:
            print(f"bw: {e}", file=sys.stderr)
            return 1
        others = guard_install.other_pretooluse_entries(path)
        if others:
            print(f"bw: other PreToolUse hooks in the same file: {', '.join(others)}")
        return 0
    guard_install.uninstall_agy(path)
    print(f"bw: removed the agy guard hook from {path}")
    return 0


def cmd_pack(a, config, state):
    try:
        r = pack_export.export(config, _panel_data(config), os.path.abspath(a.to), state, dry_run=a.dry_run)
    except pack_export.PackError as e:
        print(f"bw: pack export: {e}", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"bw: pack export: could not write {e.filename or os.path.join(a.to, 'pack.yaml')}: {e.strerror}",
              file=sys.stderr)
        return 1
    if not r["changed"]:
        print(f"bw: pack is current at {r['old_version']}; nothing written")
        return 0
    print(r["diff"], end="")
    print()
    print(r["bullet"])
    if a.dry_run:
        print("bw: dry run; nothing written")
        return 0
    print(f"bw: wrote {r['path']} ({r['old_version']} to {r['new_version']})")
    if r.get("event_error"):
        print(f"bw: warning: the pack_export event was not logged ({r['event_error']})")
    print(f"bw: next: paste the bullet in {r['bullet_path']} into esc's CHANGELOG.md, "
          "re-sign the pack with esc, and commit both in the esc repo")
    return 0


def cmd_setup(a):
    if a.what == "claude-pane":
        # Loads the config itself, for the project check only: a config error skips that check, says so,
        # and still sets up the pane.
        try:
            config = load_config()
        except ConfigError as e:
            print(f"bw: config error: {e}; the project check is skipped")
            config = None
        return claude_pane.setup(config, remove=a.remove)
    if a.remove:
        print("bw: --remove applies to bw setup claude-pane only", file=sys.stderr)
        return 2
    code, msg = ccswitch.write_settings()
    print(msg)
    return code


def cmd_seat(a, config, state):
    return seat_cli.main(a.rest, config, state)


def cmd_panel(a, config, state):
    return panel_cli.main(a.rest, config, state)


def cmd_run(a):
    """`bw run` handles a config error itself (it still runs the command), so it gets no config."""
    return run_cli.main(a.rest, sys.stdout, sys.stderr)


def cmd_live(a):
    """`bw live` prints a v1 document also on a config error (PD-12), so it gets no config."""
    return live.main(a.rest, sys.stdout, sys.stderr)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="bw", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    ld = sub.add_parser("lead")
    g = ld.add_mutually_exclusive_group()
    g.add_argument("--use"); g.add_argument("--auto", action="store_true")
    ld.add_argument("--no-rating", action="store_true")
    sub.add_parser("status")
    sub.add_parser("registry").add_argument("--print", action="store_true")
    sub.add_parser("probe").add_argument("plans", nargs="*")
    sa = sub.add_parser("start"); sa.add_argument("path", nargs="?", default=None)
    for flag in ("--dry-run", "--no-update", "--no-verify"):
        sa.add_argument(flag, action="store_true")
    ib = sub.add_parser("inbox"); ib.add_argument("--project", action="store_true"); ib.add_argument("--all", action="store_true")
    an = sub.add_parser("answer"); an.add_argument("id"); an.add_argument("text")
    ck = sub.add_parser("cockpit"); ck.add_argument("--port", type=_port, default=None)
    ck.add_argument("--no-open", action="store_true")
    c = sub.add_parser("cap"); c.add_argument("plan"); c.add_argument("--resets-at", type=float, default=None)
    sb = sub.add_parser("sandbox"); sbs = sb.add_subparsers(dest="sub", required=True)
    v = sbs.add_parser("verify"); v.add_argument("runtime"); v.add_argument("--lead", default=None)
    gd = sub.add_parser("guard"); gds = gd.add_subparsers(dest="sub", required=True)
    for name in ("install", "uninstall"):
        gds.add_parser(name).add_argument("runtime", choices=["agy"])
    gv = gds.add_parser("verify"); gv.add_argument("runtime"); gv.add_argument("--lead", default=None)
    gv.add_argument("--interactive", action="store_true")
    rv = gds.add_parser("review"); rv.add_argument("--profile", default=None)
    rv.add_argument("--recent", type=_count, default=20); rv.add_argument("--sample", type=_count, default=5)
    rv.add_argument("--list", action="store_true"); rv.add_argument("--remark", default=None, metavar="DECISION_ID")
    ev = gds.add_parser("eval"); ev.add_argument("--runtime", choices=["pi", "agy"], default="pi")
    ev.add_argument("--json", action="store_true")
    tr = sub.add_parser("triage"); trs = tr.add_subparsers(dest="sub", required=True)
    for name in ("install", "uninstall"):
        trs.add_parser(name).add_argument("runtime", choices=["claude"])
    im = sub.add_parser("improve"); im.add_argument("what", nargs="?", choices=["note", "done"])
    im.add_argument("rest", nargs="*")
    pk = sub.add_parser("pack"); pks = pk.add_subparsers(dest="sub", required=True)
    pe = pks.add_parser("export"); pe.add_argument("--to", required=True, metavar="DIR")
    pe.add_argument("--dry-run", action="store_true")
    st = sub.add_parser("setup"); st.add_argument("what", choices=["cc-switch", "claude-pane"])
    st.add_argument("--remove", action="store_true")
    sub.add_parser("seat", add_help=False)  # listed for --help; `bw seat` parses its own argv
    sub.add_parser("panel", add_help=False)  # likewise
    sub.add_parser("run", add_help=False)  # likewise
    sub.add_parser("live", add_help=False)  # likewise
    argv, outside = default_argv(sys.argv[1:] if argv is None else argv, os.getcwd())
    if argv and argv[0] in ("seat", "panel", "run", "live"):
        return _dispatch(argparse.Namespace(cmd=argv[0], rest=argv[1:]))
    a = ap.parse_args(argv)
    if outside:
        code = _dispatch(a)
        sys.stdout.flush()  # the hint follows the status, also when stdout is a pipe
        print("bw: not in a git worktree — cd into a project and run bw to lead it, or see bw --help", file=sys.stderr)
        return code
    return _dispatch(a)


def _dispatch(a):
    if a.cmd == "run":  # handles a config error itself: the command still runs
        return cmd_run(a)
    if a.cmd == "live":  # read-only; handles a config error itself
        return cmd_live(a)
    if a.cmd == "setup":  # cc-switch: only the tool's own settings file; claude-pane loads the config itself
        return cmd_setup(a)
    if a.cmd == "triage":  # touches only Claude Code's settings file, so it needs no config
        return cmd_triage(a)
    if a.cmd == "guard" and a.sub not in ("review", "verify", "eval"):  # touches only the hooks file, so it needs no config
        return cmd_guard(a, None, None)
    try:
        config = load_config()
    except ConfigError as e:
        sys.exit(f"bw: config error: {e}")
    for w in config.get("warnings", []):
        print(f"bw: config warning: {w}", file=sys.stderr)
    state = state_dir(config)
    if a.cmd == "guard":
        return cmd_guard(a, config, state)
    if a.cmd == "lead" and a.use and a.use not in config["leads"]:
        sys.exit(f"bw: unknown lead {a.use!r}")
    return {"lead": cmd_lead, "start": cmd_start, "status": cmd_status, "cap": cmd_cap, "registry": cmd_registry, "probe": cmd_probe,
            "cockpit": cmd_cockpit,
            "sandbox": cmd_verify, "inbox": cmd_inbox, "answer": cmd_answer, "improve": cmd_improve,
            "seat": cmd_seat, "panel": cmd_panel, "pack": cmd_pack}[a.cmd](a, config, state)


if __name__ == "__main__":
    sys.exit(main())
