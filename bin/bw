#!/usr/bin/env python3
"""bw — leads and rotation (build-order step 2).

  bw start [path] [--dry-run] [--no-update] [--no-verify]
                                                  update tools, re-verify, pick the lead, open it in
                                                  an Orca pane or a Terminal tab
  bw lead [--use <lead> | --auto] [--no-rating]   start the right lead for this worktree
  bw status                                       leads, quota, caps, pins, Orca and cc-switch checks
  bw probe [plan...]                              read quota now (OpenRouter key, Orca; agy awaits its
                                                  shape), one line per plan
  bw cap <plan> [--resets-at <epoch>]             record that a plan is capped
  bw inbox [--project] [--all]                    open asks from leads and notices from bw (--project: this
                                                  worktree only; --all: answered ones too)
  bw answer <id> "<text>"                         answer an ask (or close a notice); the lead reads it from
                                                  its inbox file
  bw sandbox verify <runtime> [--lead <lead>]     attack-test a bw-contained runtime, record a pass
  bw setup cc-switch                              pre-write cc-switch's settings (before its first launch)
  bw guard install agy                            add the guard hook entry to agy's hooks file
  bw guard uninstall agy                          remove it (other entries are left alone)
  bw guard verify <runtime> [--lead <lead>]       attack-test the guard on a runtime, record a pass
  bw guard review [--profile P] [--recent 20] [--sample 5] [--list]
                                                  audit stops and sampled allows, one evidence key at a time
"""
import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from lead import ccswitch, inbox, probes, quota, runner, start, status, verify  # noqa: E402
from lead.guard import AGY_AWAITS, AGY_SPIKE_PASSED, install as guard_install, review as guard_review  # noqa: E402
from lead.guard.review import safe  # noqa: E402
from lead.paths import ConfigError, load_config, state_dir  # noqa: E402  (also puts metrics/ on sys.path)
import store  # noqa: E402
from lead.projects import resolve_project  # noqa: E402


def _count(s):
    n = int(s)
    if n < 0:
        raise argparse.ArgumentTypeError("must be 0 or more")
    return n


def cmd_lead(a, config, state):
    return runner.run(config, state, os.getcwd(), use=a.use, auto=a.auto, rating=not a.no_rating)


def cmd_start(a, config, state):
    return start.start(config, state, a.path, dry_run=a.dry_run, verify=not a.no_verify, update=not a.no_update,
                       bw_path=os.path.realpath(__file__))


def cmd_status(a, config, state):
    print("\n".join(status.render(status.facts(config, state, time.time()))))
    return 0


def cmd_probe(a, config, state):
    unknown = [p for p in a.plans if p not in config["plans"]]
    if unknown:
        sys.exit(f"bw: unknown plan {unknown[0]!r}; plans: {sorted(config['plans'])}")
    now = time.time()
    names = a.plans or sorted(config["plans"])
    res = probes.refresh(config, state, now, plans=names, fetch=probes._fetch)
    every = config["rotation"]["probe_every_min"]
    arbitrated = quota.read_quota(state, config, now)
    for name in names:
        a_q = arbitrated.get(name)
        parts = [quota.summary(a_q)]  # carries the snapshot's note when its reading won
        note = (res["snapshots"].get(name) or {}).get("note")
        if note and note not in parts[0]:
            parts.append(note)
        n = quota.notice(a_q, config["plans"][name], now, every)
        if n:
            parts.append(n)
        print(f"{name}: {' — '.join(parts)}")
    for line in res["notes"]:
        print(f"bw: {line}")
    return 0


def cmd_cap(a, config, state):
    if a.plan not in config["plans"]:
        sys.exit(f"bw: unknown plan {a.plan!r}; plans: {sorted(config['plans'])}")
    c = quota.record_cap(state, a.plan, time.time(), resets_at=a.resets_at,
                         expiry_hours=config["rotation"]["cap_expiry_hours"])
    print(f"bw: {a.plan} capped until {time.ctime(c['resets_at'])}")
    return 0


def _age(ts, now):
    if not isinstance(ts, (int, float)) or isinstance(ts, bool):
        return "age unknown"
    m = max(now - ts, 0) / 60
    return f"{m:.0f}m ago" if m < 120 else f"{m / 60:.0f}h ago" if m < 48 * 60 else f"{m / 1440:.0f}d ago"


def cmd_inbox(a, config, state):
    try:
        project = resolve_project(os.getcwd(), config).worktree_key if a.project else None
    except ValueError as e:
        print(f"bw: {e}", file=sys.stderr)
        return 2
    loaded = inbox.load(state)
    for w in loaded["warnings"]:
        print(f"bw: inbox warning: {w}", file=sys.stderr)
    items = [i for i in loaded["items"] if (a.all or i["status"] == "open")
             and (project is None or i.get("project") == project)]
    if not items:
        print("bw: inbox empty")
    now = time.time()
    for i in items:
        kind = "ask" if i["type"] == "ask" else i.get("kind")
        where = i.get("worktree") or i.get("project")
        print(f"[{safe(i.get('id'))}] {safe(kind)} · {_age(i.get('ts'), now)} · from {safe(i.get('from'))} · {safe(where)}")
        print(f"  {safe(i.get('text', ''))}")
        if i["status"] == "answered":
            print(f"  answered: {safe((i.get('answer') or {}).get('text', ''))}")
    return 0


def cmd_answer(a, config, state):
    try:
        rec = inbox.answer(state, a.id, a.text)
    except KeyError:
        print(f"bw: no inbox item {safe(a.id)}; `bw inbox` lists them", file=sys.stderr)
        return 1
    except ValueError:
        print(f"bw: {safe(a.id)} is already answered", file=sys.stderr)
        return 1
    try:
        store.append(store.log_path(config), {"type": "answer", "id": rec["id"], "ask_id": a.id})
        item = next(i for i in inbox.load(state)["items"] if i.get("id") == a.id)
        if item["type"] != "ask":
            print(f"bw: closed notice {safe(a.id)}")
            return 0
        inbox.write_view(state, item["project"])
    except OSError as e:  # the answer itself is recorded; a retry would only say "already answered"
        print(f"bw: answer to {safe(a.id)} recorded, but the lead's inbox file was not refreshed "
              f"({type(e).__name__}); it will refresh at the next session start")
        return 0
    print(f"bw: answered {safe(a.id)}; the lead sees it in its inbox file; tell it to look")
    return 0


def _report(ok, msg):
    print(msg, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def cmd_verify(a, config, state):
    return _report(*verify.sandbox_verify(config, state, a.runtime, a.lead))


def cmd_guard_verify(a, config, state):
    return _report(*verify.guard_verify(config, state, a.runtime, a.lead))


def cmd_guard(a, config, state):
    if a.sub == "verify":
        return cmd_guard_verify(a, config, state)
    if a.sub == "review":
        return guard_review.run(state, profile=a.profile, recent=a.recent, sample=a.sample, list_only=a.list)
    path = guard_install.hooks_path()
    if a.sub == "install":
        if not AGY_SPIKE_PASSED:
            print(f"bw: {AGY_AWAITS}", file=sys.stderr)
            return 1
        try:
            print(guard_install.install_agy(path, state))
        except ValueError as e:
            print(f"bw: {e}", file=sys.stderr)
            return 1
        others = guard_install.other_pretooluse_entries(path)
        if others:
            print(f"bw: other PreToolUse hooks in the same file: {', '.join(others)}")
        return 0
    guard_install.uninstall_agy(path)
    print(f"bw: removed the agy guard hook from {path}")
    return 0


def cmd_setup(a):
    code, msg = ccswitch.write_settings()
    print(msg)
    return code


def main(argv=None):
    ap = argparse.ArgumentParser(prog="bw", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    ld = sub.add_parser("lead")
    g = ld.add_mutually_exclusive_group()
    g.add_argument("--use"); g.add_argument("--auto", action="store_true")
    ld.add_argument("--no-rating", action="store_true")
    sub.add_parser("status")
    sub.add_parser("probe").add_argument("plans", nargs="*")
    sa = sub.add_parser("start"); sa.add_argument("path", nargs="?", default=None)
    for flag in ("--dry-run", "--no-update", "--no-verify"):
        sa.add_argument(flag, action="store_true")
    ib = sub.add_parser("inbox"); ib.add_argument("--project", action="store_true"); ib.add_argument("--all", action="store_true")
    an = sub.add_parser("answer"); an.add_argument("id"); an.add_argument("text")
    c = sub.add_parser("cap"); c.add_argument("plan"); c.add_argument("--resets-at", type=float, default=None)
    sb = sub.add_parser("sandbox"); sbs = sb.add_subparsers(dest="sub", required=True)
    v = sbs.add_parser("verify"); v.add_argument("runtime"); v.add_argument("--lead", default=None)
    gd = sub.add_parser("guard"); gds = gd.add_subparsers(dest="sub", required=True)
    for name in ("install", "uninstall"):
        gds.add_parser(name).add_argument("runtime", choices=["agy"])
    gv = gds.add_parser("verify"); gv.add_argument("runtime"); gv.add_argument("--lead", default=None)
    rv = gds.add_parser("review"); rv.add_argument("--profile", default=None)
    rv.add_argument("--recent", type=_count, default=20); rv.add_argument("--sample", type=_count, default=5)
    rv.add_argument("--list", action="store_true")
    st = sub.add_parser("setup"); st.add_argument("what", choices=["cc-switch"])
    a = ap.parse_args(argv)
    if a.cmd == "setup":  # touches only the tool's own settings file, so it needs no config
        return cmd_setup(a)
    if a.cmd == "guard" and a.sub not in ("review", "verify"):  # touches only the hooks file, so it needs no config
        return cmd_guard(a, None, None)
    try:
        config = load_config()
    except ConfigError as e:
        sys.exit(f"bw: config error: {e}")
    for w in config.get("warnings", []):
        print(f"bw: config warning: {w}", file=sys.stderr)
    state = state_dir(config)
    if a.cmd == "guard":
        return cmd_guard(a, config, state)
    if a.cmd == "lead" and a.use and a.use not in config["leads"]:
        sys.exit(f"bw: unknown lead {a.use!r}")
    return {"lead": cmd_lead, "start": cmd_start, "status": cmd_status, "cap": cmd_cap, "probe": cmd_probe,
            "sandbox": cmd_verify, "inbox": cmd_inbox, "answer": cmd_answer}[a.cmd](a, config, state)


if __name__ == "__main__":
    sys.exit(main())
